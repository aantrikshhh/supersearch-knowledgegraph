    "id": "clarify_generic_wedding_then_general_women",
    "brand": "aza",
    "description": "Generic wedding guest query should ask for wedding context and gender, then preserve budget after the user answers.",
    "turns": [
      {
        "user": "Affordable wedding guest outfit - don't want to spend too much",
        "expect": {
          "workflow": "occasion",
          "needs_clarification": true,
          "clarifying_contains": ["wedding context", "women, men, or kids"],
          "intent_equals": {"occasion": "wedding", "budget": "affordable"},
          "intent_truthy": ["_needs_religion"],
          "max_primary_products": 0
        }
      },
      {
        "user": "general wedding guest women",
        "expect": {
          "workflow": "occasion",
          "needs_clarification": false,
          "is_followup": true,
          "intent_equals": {"occasion": "wedding", "gender": "female", "budget": "affordable"},
          "intent_absent": ["_needs_religion"],
          "min_db_products": 1,
          "min_primary_products": 1,
          "sql_contains": ["gender IN", "NOT"],
          "sql_not_contains": ["LIKE '%,red,%' THEN 0"],
          "response_not_contains": ["black accents", "red accents", "white accents"]
        }
      }
    ]
  },
